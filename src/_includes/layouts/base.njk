<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} | {% endif %}{{ site.name }}</title>
<meta name="description" content="{{ (snippet or description or site.subtitle) | plain }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png">
<link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png">
<link rel="apple-touch-icon" href="/favicon-448x448.png">
<link rel="stylesheet" href="/design-system/css/tokens.css">
<link rel="stylesheet" href="/design-system/css/bundle.css">
</head>
<body class="ds-page">
<div class="ds-shell{% if shell == 'article' %} ds-shell--article{% endif %}">
{% include "masthead.njk" %}
{{ content | safe }}
{% include "footer.njk" %}
</div>
<script src="/design-system/js/ds.js"></script>
</body>
</html>
